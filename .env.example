# ---- Correo transaccional (ZeptoMail, de Zoho) ----
# La llave se saca en ZeptoMail -> Mail Agents -> tu agente -> "Send Mail Token".
# El primer crédito (10.000 correos) es gratis; después, 2,50 USD por cada 10.000.
# CORREO_REMITENTE exige dominio propio verificado; el de respuesta no.
ZEPTOMAIL_API_KEY=
# Solo si la cuenta es del centro de datos europeo:
# ZEPTOMAIL_API_BASE=https://api.zeptomail.eu/v1.1/email
CORREO_REMITENTE="Santander Xtreme <inscripciones@tudominio.com>"
CORREO_RESPUESTA=oficialsangilxtreme@gmail.com

# ---- App ----
URL_PUBLICA=http://localhost:3000
# Vercel inyecta este nombre exacto en el cron.
CRON_SECRET=

# ---- Base de datos (Neon / cualquier Postgres) ----
# Sin esto, la app guarda en .datos/ (solo para demo).
DATABASE_URL="postgresql://usuario:clave@host/db?sslmode=verify-full"

# --- Panel de la organización ---
# Firma la cookie de sesión. Mínimo 16 caracteres; genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PANEL_SECRETO=
# Clave compartida que se le da a quien revisa comprobantes.
PANEL_CLAVE=

# --- Evidencias de pago (Vercel Blob) ---
# Sin este token las evidencias se guardan en .datos/ (modo simulación).
BLOB_READ_WRITE_TOKEN=

# ---- Cuentas de recaudo (pago manual por transferencia) ----
# Si no se configuran, se usa el valor real de producción como respaldo.
# Ojo: no llevan NEXT_PUBLIC_, así que solo existen en el servidor.
RECAUDO_TITULAR=
RECAUDO_BANCOLOMBIA=
RECAUDO_CELULAR=
# Llave Bre-B de la cuenta Bancolombia. Es un alias, no el celular.
RECAUDO_LLAVE_BRE_B=
